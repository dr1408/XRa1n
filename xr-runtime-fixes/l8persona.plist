<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ElleKit/Substrate filter. Persona resolution for an install happens in
	  installd (MobileInstallation) and installcoordinationd (IXApplicationIdentity
	  calls the same MIAppIdentity method), so only those two load this.
	-->
	<key>Filter</key>
	<dict>
		<key>Executables</key>
		<array>
			<string>installd</string>
			<string>installcoordinationd</string>
		</array>
	</dict>
</dict>
</plist>
